{
  "name": "ProjectFolder",
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Folder name (author name, series name, etc.)"
    },
    "folder_type": {
      "type": "string",
      "enum": [
        "author",
        "series",
        "custom"
      ],
      "default": "custom",
      "description": "Type of folder grouping"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent folder ID for nesting (e.g. series inside author)"
    },
    "color": {
      "type": "string",
      "description": "Optional accent color for the folder"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}